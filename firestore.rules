rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════
    //  GOREX LUXURY CONCIERGE — règles Firestore durcies
    //
    //  PRINCIPE DIRECTEUR : REFUS PAR DÉFAUT.
    //  Aucune règle générique n'accorde l'accès à « une collection
    //  quelconque ». Chaque collection est nommée et son droit est explicite.
    //  Toute collection non listée est inaccessible (voir le match final).
    //
    //  Failles corrigées par rapport à la version précédente :
    //   1. `user_profiles` : le rôle ne peut plus être écrit par l'utilisateur
    //      (un client pouvait s'écrire role = 'ceo' → administration totale).
    //   2. Le fourre-tout `match /{document=**} { if isStaff() }` est supprimé
    //      (il ouvrait TOUTES les collections en lecture ET en écriture).
    //   3. `audit_log` : lecture réservée au CEO (le journal fuyait vers tous
    //      les comptes : RGPD + renseignement interne).
    //   4. `staff` : auto-modification limitée aux champs de contact, plus
    //      aucun moyen de s'élever à un autre rôle.
    //   5. Le rôle fait foi EN BASE : une claim obsolète ne maintient plus des
    //      droits révoqués jusqu'à l'expiration du jeton.
    //   6. Données bancaires et financières réservées aux rôles finance/CEO.
    //   7. `gorex_cloud` (sauvegarde de l'ÉTAT COMPLET) réservé à la direction.
    // ═══════════════════════════════════════════════════════════════════

    // ─────────────────────────── IDENTITÉ ───────────────────────────

    function isSignedIn() { return request.auth != null; }

    // Interdit les sessions anonymes : sans identité nominative, aucun droit.
    function isRealUser() {
      return isSignedIn()
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Profil d'identité (uid → rôle métier + clientId).
    function myProfile() {
      return exists(/databases/$(database)/documents/user_profiles/$(request.auth.uid))
             ? get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data
             : null;
    }

    // Le rôle affiché par la base PRIME sur la claim du jeton.
    // Conséquence voulue : révoquer un rôle en base le révoque immédiatement,
    // sans attendre l'expiration du jeton (1 h).
    function claimRole() { return request.auth.token.role; }
    function myRole() {
      return myProfile() != null && myProfile().role is string
             ? myProfile().role
             : claimRole();
    }

    function isCeo() { return isRealUser() && myRole() == 'ceo'; }

    function isConciergeManager() {
      return isRealUser() && myRole() == 'conciergeManager';
    }

    // Rôles métier valides. 'ceo' en est volontairement EXCLU : il sert à
    // vérifier qu'une promotion vers la direction ne peut pas être écrite par
    // un simple manager.
    function staffRoles() {
      return [
        'conciergeManager', 'seniorConcierge', 'concierge',
        'lifestyleManager', 'travelManager', 'securityCoordinator', 'finance'
      ];
    }

    function isFinanceRole() {
      return isRealUser() && (myRole() == 'finance' || myRole() == 'ceo');
    }

    // Personnel = tout rôle métier sauf le client VIP.
    function isStaff() {
      return isRealUser() && myRole() is string && myRole() != 'vipClient';
    }

    function isClient() { return isRealUser() && myRole() == 'vipClient'; }

    // Rôles habilités à DÉCIDER de l'ouverture d'un compte client.
    //
    // L'ouverture d'un accès est une décision commerciale et de confiance :
    // elle est réservée à l'encadrement. Un concierge peut consulter et
    // mettre à jour une fiche client, mais ne peut pas, à lui seul, ouvrir
    // l'accès d'une personne inconnue aux services de la conciergerie.
    function isApprover() {
      return isRealUser()
             && (myRole() == 'ceo'
                 || myRole() == 'conciergeManager'
                 || myRole() == 'seniorConcierge');
    }

    // Identifiant de dossier du client connecté, lu en base (jamais dans le
    // jeton, qu'un utilisateur ne peut pas modifier mais qui peut être ancien).
    function myClientId() {
      return myProfile() != null && myProfile().clientId is string
             ? myProfile().clientId
             : '';
    }

    // Le dossier du client connecté est-il VALIDÉ par l'équipe ?
    //
    // FAILLE CORRIGÉE. La règle de `requests` n'exigeait que la concordance
    // d'e-mail : un compte fraîchement inscrit, donc NON validé, pouvait
    // déposer une demande de service par un appel direct à l'API. Le blocage
    // n'existait que dans l'interface, ce qui n'est pas une protection.
    //
    // Le contrôle est fait EN BASE (get) et non depuis le jeton : une
    // validation — ou une suspension — prend effet immédiatement, sans
    // attendre l'expiration du jeton (1 h).
    //
    // NB : les règles n'ont pas d'opérateur ternaire. Si la fiche n'existe
    // pas, `get()` échoue, la règle est évaluée à false et l'accès est
    // refusé : c'est exactement le comportement voulu.
    function approvedClientRecord() {
      return get(/databases/$(database)/documents/clients/$(myClientId())).data;
    }

    // Un client ne peut consommer un service que si son dossier est validé
    // ET actif. Ces conditions sont volontairement redondantes avec
    // Client.hasServiceAccess côté application.
    function isApprovedClient() {
      return isClient()
             && myClientId() != ''
             && approvedClientRecord().approvalStatus == 'approved'
             && approvedClientRecord().active == true;
    }


    // Un document « appartient » au client connecté si son clientId correspond.
    function ownsClientData(d) {
      return isClient() && myClientId() != '' && d.clientId == myClientId();
    }

    // ─────────────── Helpers de contrôle de champs ───────────────

    // NB : les règles Firestore n'ont PAS d'opérateur ternaire. La version
    // « resource != null ? … : … » casse l'évaluation (erreurs au journal) et
    // a donc été écartée. Les règles de création n'appellent pas ces helpers.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function only(list) { return changedKeys().hasOnly(list); }

    // Un client ne peut modifier que ses coordonnées sur sa fiche `clients`.
    function onlyOwnContactFields() {
      return only(['fullName', 'phone', 'language', 'updatedAt']);
    }

    // ══════════════════════ PROFILS D'IDENTITÉ ══════════════════════
    //
    // FAILLE #1 CORRIGÉE. Avant : `allow create, update: if uid == request.auth.uid`
    // → un client s'écrivait `role: 'ceo'` et devenait administrateur.
    // Désormais : à la CRÉATION le rôle est imposé à 'vipClient' ; en MISE À
    // JOUR les clés d'autorisation sont interdites.
    match /user_profiles/{uid} {
      allow read: if isRealUser() && (request.auth.uid == uid || isStaff());

      allow create: if isRealUser()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'vipClient'
                    && request.resource.data.clientId is string
                    && !(request.resource.data.keys().hasAny(
                          ['permissions', 'isStaff', 'isAdmin']));

      // Le titulaire maintient son identité, jamais son niveau de droit.
      allow update: if isRealUser()
                    && request.auth.uid == uid
                    && !changedKeys().hasAny(['role', 'clientId', 'permissions', 'isStaff']);

      // Réalignement administratif (création d'un compte, correction de rôle).
      allow update, delete: if isCeo();
    }

    // ══════════════════════════ COMPTES DU PERSONNEL ══════════════════════════
    //
    // FAILLE #4 CORRIGÉE. Avant : `allow update: if uid == request.auth.uid`
    // → n'importe quel concierge se promouvait 'ceo'.
    // Désormais l'auto-modification est bornée aux coordonnées, et le rôle
    // reste hors de portée du titulaire.
    match /staff/{uid} {
      allow read: if isRealUser() && (request.auth.uid == uid || isStaff());

      // Le CEO peut tout créer ou supprimer.
      allow create, delete: if isCeo();

      // Un manager peut créer un compte métier, mais jamais un CEO, et jamais
      // avec un champ d'autorisation inventé.
      allow create: if isConciergeManager()
                    && request.resource.data.role in staffRoles();

      // Le titulaire : coordonnées et drapeau de changement de mot de passe.
      allow update: if isRealUser()
                    && request.auth.uid == uid
                    && only(['displayName', 'fullName', 'phone',
                             'mustChangePassword', 'language', 'lastLogin']);

      // Le manager : gestion des accès, mais SANS pouvoir élever un compte
      // vers la direction ni vers un rôle hors périmètre.
      allow update: if isConciergeManager()
                    && !changedKeys().hasAny(['role'])
                    && only(['displayName', 'fullName', 'phone', 'department',
                             'active', 'mustChangePassword', 'language']);

      // Le CEO : tout, y compris le rôle.
      allow update: if isCeo();
    }

    // ══════════════════════ ANNUAIRE APPLICATIF ══════════════════════
    match /users/{uid} {
      allow read: if isRealUser() && (request.auth.uid == uid || isStaff());
      allow write: if isCeo();
    }

    // ══════════════════════════ JOURNAL D'AUDIT ══════════════════════════
    //
    // FAILLE #3 CORRIGÉE. Avant : `allow read: if isRealUser()` → tout compte
    // lisait l'intégralité du journal (qui a fait quoi, quand, sur qui).
    // Le journal est APPEND-ONLY : aucune modification, aucune suppression,
    // par personne — pas même le CEO.
    match /audit_log/{entry} {
      allow read: if isCeo();
      allow create: if isRealUser();
      allow update, delete: if false;
    }

    // ══════════════════════════ FICHES CLIENTS ══════════════════════════
    //
    // L'e-mail du document doit correspondre à celui du jeton : un client ne
    // peut ni lire ni créer la fiche de quelqu'un d'autre. La mise à jour est
    // bornée aux coordonnées (ni tarif, ni statut, ni note interne).
    match /clients/{doc} {
      allow read: if isStaff()
                  || (isRealUser() && resource.data.email == request.auth.token.email);

      // ── VALIDATION OBLIGATOIRE À L'INSCRIPTION ──
      // Une personne qui s'inscrit elle-même ne peut déposer qu'un dossier
      // EN ATTENTE : `approvalStatus` est imposé à 'pending' par la règle.
      // Sans cette contrainte, elle pourrait écrire 'approved' directement
      // via l'API REST et contourner entièrement la validation du personnel.
      //
      // DÉFAUT CORRIGÉ : la branche « personnel » autorisait n'importe quel
      // rôle métier à créer une fiche DÉJÀ VALIDÉE. Un concierge — le rôle le
      // moins élevé — ouvrait donc un accès complet en une seule écriture, ce
      // qui vidait de son sens la règle de décision ci-dessous. Désormais :
      //   • l'encadrement (isApprover) peut créer une fiche validée ;
      //   • les autres membres du personnel ne créent que des fiches EN
      //     ATTENTE, qui devront être validées par l'encadrement ;
      //   • le public ne crée que sa propre fiche, en attente.
      allow create: if isApprover()
                    || (isStaff()
                        && request.resource.data.approvalStatus == 'pending'
                        && request.resource.data.active == true)
                    || (isRealUser()
                        && request.resource.data.email == request.auth.token.email
                        && request.resource.data.approvalStatus == 'pending'
                        && request.resource.data.active == true);

      // ── SÉPARATION DES DROITS SUR LA DÉCISION D'ACCÈS ──
      // Le personnel met à jour une fiche client (coordonnées, palier,
      // notes…), mais les DEUX champs qui ouvrent ou ferment l'accès aux
      // services sont réservés à l'encadrement. Sans cette séparation, un
      // concierge pouvait ouvrir l'accès d'un inconnu en une seule écriture.
      allow update: if isStaff()
                    && !changedKeys().hasAny(['approvalStatus', 'active']);

      allow update: if isApprover();

      // Le titulaire ne peut modifier QUE ses coordonnées (voir
      // onlyOwnContactFields) : `approvalStatus` et `active` restent hors de
      // sa portée, donc une fois le dossier déposé il ne peut plus le
      // valider lui-même.
      allow update: if isRealUser()
                    && resource.data.email == request.auth.token.email
                    && onlyOwnContactFields();

      allow delete: if isCeo() || isConciergeManager();
    }

    // ══════════════════════ RÉSERVATION DES NUMÉROS DE DOSSIER ═══════════════
    //
    // Un document par numéro attribué : `client_codes/GRX-VIP-0007`.
    //
    // POURQUOI UN DOCUMENT ET PAS UN COMPTEUR. Un compteur incrémenté serait
    // lu puis réécrit : deux validateurs simultanés liraient la même valeur et
    // écriraient le même numéro. Ici l'attribution repose sur la CRÉATION d'un
    // document avec la précondition « n'existe pas encore »
    // (`currentDocument.exists = false`) : c'est le serveur qui arbitre, et le
    // second appelant reçoit ALREADY_EXISTS. Un numéro ne peut donc pas être
    // attribué deux fois, même en concurrence parfaite.
    //
    // Lecture réservée au personnel : un client n'a aucune raison de parcourir
    // la liste des numéros, qui révélerait le volume de la clientèle.
    match /client_codes/{code} {
      allow read: if isStaff();

      // Création seule, par l'encadrement. Aucune mise à jour ni suppression :
      // un numéro attribué doit rester attribué, sinon il redeviendrait
      // disponible et pourrait être réutilisé pour un autre dossier.
      allow create: if isApprover()
                    && request.resource.data.code == code;
    }

    // ══════════════════════════ DEMANDES DE SERVICE ══════════════════════════
    //
    // Le contrôle porte sur `clientEmail` (champ scalaire indexable) et non sur
    // un get() : une règle fondée sur `resource.data` impose au client de
    // filtrer sa requête, ce que l'application fait déjà.
    match /requests/{doc} {
      allow read: if isStaff()
                  || (isRealUser()
                      && resource.data.clientEmail == request.auth.token.email);

      // FAILLE CORRIGÉE : la seule concordance d'e-mail ne suffisait pas.
      // Un compte inscrit mais NON validé pouvait déposer une demande par
      // appel direct à l'API, en contournant l'écran d'attente. Il faut
      // désormais que le dossier soit validé ET actif en base.
      allow create: if isStaff()
                    || (isApprovedClient()
                        && request.resource.data.clientEmail == request.auth.token.email);

      allow update, delete: if isStaff();
    }

    // ══════════════════════ DOSSIERS MÉTIER ══════════════════════

    match /bookings/{doc} {
      allow read: if isStaff() || ownsClientData(resource.data);
      // Même exigence que pour `requests` : consommer un service suppose un
      // dossier validé ET actif, pas seulement un clientId qui correspond.
      allow create: if isStaff()
                    || (isApprovedClient() && ownsClientData(request.resource.data));
      allow update, delete: if isStaff();
    }

    // Les pièces financières sont lisibles par le client concerné, mais seul
    // le personnel habilité les émet : un client ne peut pas s'auto-facturer
    // ni modifier un montant.
    match /finance_docs/{doc} {
      allow read: if isStaff() || ownsClientData(resource.data);
      allow write: if isStaff();
    }

    match /itineraries/{doc} {
      allow read: if isStaff() || ownsClientData(resource.data);
      allow write: if isStaff();
    }

    match /appointments/{doc} {
      allow read: if isStaff() || ownsClientData(resource.data);
      allow write: if isStaff();
    }

    match /conversations/{doc} {
      allow read: if isStaff() || ownsClientData(resource.data);
      allow create: if isStaff() || ownsClientData(request.resource.data);
      allow update: if isStaff() || ownsClientData(resource.data);
      allow delete: if isStaff();
    }

    // ══════════════════════ RÉFÉRENTIELS ══════════════════════

    match /providers/{doc}       { allow read, write: if isStaff(); }
    match /prospects/{doc}       { allow read, write: if isStaff(); }

    // Données strictement financières : ni un concierge ni un manager n'y ont
    // accès, seuls les rôles finance et le CEO.
    match /expenses/{doc}        { allow read, write: if isFinanceRole(); }
    match /bank_transactions/{doc} { allow read, write: if isFinanceRole(); }

    // Paramètres de facturation (identité légale, TVA, Peppol).
    match /company/{doc} {
      allow read: if isRealUser();
      allow write: if isFinanceRole();
    }

    match /subscription_tiers/{doc} {
      allow read: if isRealUser();
      allow write: if isFinanceRole();
    }

    // ══════════════════════ ABONNEMENTS (CONTRATS) ══════════════════════
    //
    // POURQUOI UNE COLLECTION DÉDIÉE. Un contrat d'abonnement ne peut pas
    // vivre dans `gorex_cloud` : ce document n'est lisible que par le CEO et
    // le concierge manager, alors que le client doit pouvoir consulter SON
    // propre contrat depuis n'importe quel appareil (exigence §1).
    //
    // MODÈLE DE SÉCURITÉ — trois propriétés, chacune indispensable :
    //
    //  1. LECTURE. Le client ne lit que ses propres abonnements, via
    //     `ownsClientData(resource.data)`. Le personnel lit l'ensemble (il
    //     doit pouvoir traiter les demandes et facturer).
    //
    //  2. CRÉATION PAR LE CLIENT, SOUS CONDITION STRICTE. Un client peut
    //     déposer une demande, mais UNIQUEMENT :
    //       • sur SON dossier (`request.resource.data.clientId == myClientId()`) ;
    //       • avec le statut `requested` — il ne peut pas écrire `active`,
    //         sinon il se rendrait facturable puis contesterait le prélèvement ;
    //       • sans se déclarer accepté, actif ou décidé (`decidedAt`,
    //         `decidedBy`, `activatedAt` absents du document créé).
    //     Ces trois points sont vérifiés séparément : la condition d'état seul
    //     ne suffirait pas, un client pourrait créer un document `requested`
    //     en y glissant `decidedBy: 'ceo@gorex-group.eu'`.
    //
    //  3. MODIFICATION. Après création, le client ne peut PLUS RIEN changer :
    //     une demande est un fait daté. Le personnel, lui, décide et active.
    //     Un abonnement n'est jamais supprimé : il est `ended` (traçabilité
    //     comptable — on ne fait pas disparaître un contrat).
    match /subscriptions/{doc} {
      allow read: if isFinanceRole()
                  || isApprover()
                  || ownsClientData(resource.data);

      allow create: if isFinanceRole()
                    || isApprover()
                    || (isApprovedClient()
                        && request.resource.data.clientId == myClientId()
                        && request.resource.data.status == 'requested'
                        && request.resource.data.get('decidedAt', null) == null
                        && request.resource.data.get('decidedBy', null) == null
                        && request.resource.data.get('activatedAt', null) == null);

      // Le client n'a aucun droit d'écriture après création : seul le
      // personnel décide, active, suspend ou clôt.
      allow update: if isFinanceRole() || isApprover();
      allow delete: if false;
    }

    // ══════════════════════ SAUVEGARDE D'ÉTAT ══════════════════════
    //
    // Ce document contient une copie de l'ÉTAT APPLICATIF COMPLET. En lecture
    // il exposerait toutes les données ; en écriture il permettrait de
    // réinjecter un état falsifié (rôles, soldes, tarifs). Réservé à la
    // direction : CEO et concierge manager.
    match /gorex_cloud/{doc} {
      allow read, write: if isCeo() || isConciergeManager();
    }

    // ══════════════════════ DOMICILIATION SEPA ══════════════════════
    //
    // Ces documents contiennent des IBAN : données financières à caractère
    // personnel.
    //
    // ── CORRECTION D'UNE ERREUR DE RAISONNEMENT ─────────────────────────
    // La version précédente interdisait TOUTE écriture client, avec ce
    // motif : « un client pourrait remplacer l'IBAN par celui d'un tiers et
    // détourner un prélèvement ». C'était faux : prélever sur un autre IBAN,
    // c'est débiter un tiers au profit de Gorex, pas au profit du client.
    // Le vrai risque — un mandat écrit sur le dossier d'un AUTRE client —
    // est couvert par `clientId == myClientId()`.
    //
    // Conséquence de cette interdiction : le circuit était bloqué. Un mandat
    // SEPA est signé par le DÉBITEUR ; seul le client peut donc le créer
    // légitimement. Sans cette voie, aucun client ne pouvait jamais être
    // facturé autrement que par une saisie manuelle de la finance.
    //
    // Conditions exigées pour la création par un client :
    //   • mandat rattaché à SON dossier (`clientId == myClientId()`) ;
    //   • dossier validé et actif (`isApprovedClient()`) ;
    //   • statut `active` — le client signe, donc le mandat est valide ; il ne
    //     peut pas en revanche écrire `cancelledAt` ni `lastUsedAt`, champs
    //     qui appartiennent au cycle de facturation et non à la signature.
    //
    // La finance conserve le droit de révoquer ou suspendre (`update`).
    match /sepa_mandates/{doc} {
      allow read: if isFinanceRole() || ownsClientData(resource.data);

      // ── BUG DE PRODUCTION CORRIGÉ ICI ────────────────────────────────
      // La condition exigeait `signatureDate is string`. Or l'application
      // écrit ses dates au format ISO 8601, et l'encodeur REST Firestore les
      // convertit en `timestampValue` : le serveur stocke donc un TIMESTAMP,
      // jamais une chaîne. La règle refusait l'écriture de l'application
      // elle-même — 403 « Missing or insufficient permissions » observé en
      // production, alors que l'émulateur répondait « autorisé » parce que
      // mes tests y envoyaient, eux, une vraie chaîne.
      //
      // Les deux formes sont désormais acceptées : c'est la présence de la
      // date de signature qui compte, pas son encodage.
      allow create: if isFinanceRole()
                    || (isApprovedClient()
                        && request.resource.data.clientId == myClientId()
                        && request.resource.data.status == 'active'
                        && request.resource.data.mandateReference is string
                        && request.resource.data.iban is string
                        && request.resource.data.accountHolder is string
                        && (request.resource.data.signatureDate is timestamp
                            || request.resource.data.signatureDate is string)
                        && request.resource.data.get('cancelledAt', null) == null
                        && request.resource.data.get('lastUsedAt', null) == null);

      allow update: if isFinanceRole();
      // Un mandat n'est jamais supprimé : il est révoqué (traçabilité).
      allow delete: if false;
    }

    match /sepa_debits/{doc} {
      allow read: if isFinanceRole() || ownsClientData(resource.data);
      allow create, update: if isFinanceRole();
      allow delete: if isFinanceRole();
    }

    // ══════════════════════ REFUS PAR DÉFAUT ══════════════════════
    //
    // FAILLE #2 CORRIGÉE. La version précédente terminait par
    //   match /{document=**} { allow read, write: if isStaff(); }
    // qui ouvrait en lecture ET en écriture toute collection existante ou
    // future. Une collection ajoutée demain était donc publique de fait.
    // Désormais : tout ce qui n'est pas nommé ci-dessus est inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
