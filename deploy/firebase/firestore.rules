rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────
    // GOREX GROUP — Règles de sécurité Firestore (production, Phase B)
    //
    //  • Personnel : rôle dans le jeton (`role`) ; CEO = administrateur.
    //  • Client   : identifié par `user_profiles/{uid}.clientId`.
    //  • Un client ne lit QUE ses propres dossiers ; ne peut pas les modifier.
    //  • Le journal d'audit est append-only.
    // ─────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Session NOMINATIVE réelle (exclut la session anonyme technique).
    function isRealUser() {
      return isSignedIn()
             && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function role() {
      return isRealUser() ? request.auth.token.role : null;
    }

    function isAdmin() {
      return isRealUser() && role() == 'ceo';
    }

    function isStaff() {
      return isRealUser() && role() is string && role() != 'vipClient';
    }

    function isClient() {
      return isRealUser() && role() == 'vipClient';
    }

    // clientId du client connecté (document user_profiles/{uid}).
    function clientId() {
      return exists(/databases/$(database)/documents/user_profiles/$(request.auth.uid))
             ? get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.clientId
             : '';
    }

    // Le document appartient-il au client connecté ?
    function ownsClientData(d) {
      return isClient() && d.clientId == clientId();
    }

    // ── Profils d'identité (uid → clientId / rôle) ──
    match /user_profiles/{uid} {
      allow read: if isRealUser() && (request.auth.uid == uid || isStaff());
      allow create, update: if isRealUser() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ── Comptes du personnel ──
    // Lecture : utilisateur nominatif. Écriture : CEO uniquement (pas d'auto-promotion).
    match /staff/{uid} {
      allow read: if isRealUser();
      allow write: if isAdmin();
    }

    // ── Comptes utilisateurs (collection applicative) ──
    match /users/{uid} {
      allow read: if isRealUser();
      allow write: if isAdmin();
    }

    // ── Journal d'audit : append-only ──
    match /audit_log/{entry} {
      allow read: if isRealUser();
      allow create: if isRealUser();
      allow update, delete: if false;
    }

    // ── Clients ──
    // Personnel : accès complet. Client : lecture de sa seule fiche (par e-mail).
    match /clients/{doc} {
      allow read: if isStaff() || (isClient() && resource.data.email == request.auth.token.email);
      allow write: if isStaff();
    }

    // ── Dossiers métier : le client ne lit que les siens, n'écrit pas ──
    match /requests/{doc} {
      allow read: if isStaff() || ownsClientData(resource.data);
      allow create: if isStaff() || ownsClientData(request.resource.data);
      allow update, delete: if isStaff();
    }
    match /bookings/{doc} {
      allow read: if isStaff() || ownsClientData(resource.data);
      allow create: if isStaff() || ownsClientData(request.resource.data);
      allow update, delete: if isStaff();
    }
    match /finance_docs/{doc} {
      allow read: if isStaff() || ownsClientData(resource.data);
      allow write: if isStaff();
    }
    match /itineraries/{doc} {
      allow read: if isStaff() || ownsClientData(resource.data);
      allow write: if isStaff();
    }
    match /conversations/{doc} {
      allow read: if isStaff() || ownsClientData(resource.data);
      allow create: if isStaff() || ownsClientData(request.resource.data);
      allow update: if isStaff() || ownsClientData(resource.data);
      allow delete: if isStaff();
    }
    match /appointments/{doc} {
      allow read: if isStaff() || ownsClientData(resource.data);
      allow write: if isStaff();
    }

    // ── État synchronisé global : RÉSERVÉ AU PERSONNEL ──
    // (les clients reçoivent leurs données via les collections ci-dessus).
    match /gorex_cloud/{doc} {
      allow read, write: if isStaff();
    }

    // ── Fournisseurs, dépenses, CRM, etc. : personnel uniquement ──
    match /providers/{doc}  { allow read, write: if isStaff(); }
    match /expenses/{doc}   { allow read, write: if isStaff(); }
    match /prospects/{doc}  { allow read, write: if isStaff(); }

    // ── Tout le reste : personnel uniquement ──
    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
